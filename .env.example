# Core LLM API
OPENCODE_API_KEY=your_opencode_api_key_here
OPENCODE_MODEL=nemotron-3.5-flash-free

# Optional: Serper.dev API key -> fast single-connection Google search
# (https://serper.dev/). Free tier: 2,500 queries, NO credit card / billing
# required. If empty, the assistant falls back to keyless DuckDuckGo (ddgs).
SERPER_API_KEY=

# Optional: PostgreSQL connection string for grievance storage.
# If unset, the app uses a local SQLite file (grievances.db).
DATABASE_URL=

# Optional: CORS allowed origins for the web API (comma-separated).
# Example: CORS_ORIGINS=https://myapp.example.com,https://admin.example.com
# If unset, defaults to "*" (all origins — suitable for local development only).
CORS_ORIGINS=

# Optional: PACS Operator API key for write-protected endpoints.
# Protects PATCH /api/grievances/{id} and DELETE /api/documents operations.
# Set the X-PACS-Key header to this value in operator requests.
# If unset, those endpoints are open (local dev mode).
PACS_OPERATOR_KEY=

# Optional: Whisper model configuration (used by web STT and CLI chatbot)
WHISPER_MODEL_SIZE=medium
WHISPER_DEVICE=cpu
WHISPER_COMPUTE=int8
